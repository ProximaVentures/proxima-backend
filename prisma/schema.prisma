// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Enforce data integrity with strict Enumerations.
enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalCategory {
  SOFTWARE_DEVELOPER
  PROJECT_MANAGER
  PRODUCT_DESIGNER
  GRAPHIC_DESIGNER
  CONTENT_CREATOR
  DIGITAL_MARKETER
  ACCOUNTANT
  VIDEO_EDITOR
  SOCIAL_MEDIA_MANAGER
  LAWYER
  HR_SPECIALIST
  DATA_ANALYST
}

enum VettingStatus {
  PENDING
  VETTED
  REJECTED
}

enum ProjectStatus {
  PENDING
  REVIEWING
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum PitchStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum BudgetTier {
  UNDER_5K
  FROM_5K_TO_10K
  FROM_10K_TO_25K
  FROM_25K_TO_50K
  ABOVE_50K
}

enum TimelineTier {
  UNDER_1_MONTH
  FROM_1_TO_3_MONTHS
  FROM_3_TO_6_MONTHS
  ABOVE_6_MONTHS
}

// ────────── NEW ENUMS for Client Dashboard ──────────

enum SprintStatus {
  PLANNED
  ACTIVE
  IN_REVIEW
  APPROVED
  COMPLETED
  ON_HOLD
}

enum DeliverableType {
  PDF_DOCUMENT
  GITHUB_REPOSITORY
  FIGMA_FILE
  IMAGE
  VIDEO
  OTHER
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
}

// ────────────────── MODELS ──────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?
  password      String?
  role          Role      @default(CLIENT)
  roles         Role[]    @default([CLIENT])
  provider      String    @default("credentials")
  providerId    String?
  phone         String?
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  otps          OTP[]
  profile       Profile?
  projects      Project[]
  pitches       InvestmentPitch[]
  assignments   ProjectAssignment[]
  notifications Notification[]

  // Project Manager relation
  managedProjects Project[] @relation("managedProjects")

  // Messaging relations
  conversations ConversationParticipant[]
  messages      Message[]
  
  // Meeting relations
  createdMeetings Meeting[] @relation("MeetingCreator")
}

model Profile {
  id              String                @id @default(cuid())
  userId          String                @unique
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  jobTitle        String?
  city            String?
  country         String?
  bio             String?
  avatarUrl       String?
  
  // Professional specific fields
  category        ProfessionalCategory?
  vettingStatus   VettingStatus         @default(PENDING)
  onboardingComplete Boolean            @default(false)
  hasSeenRolePrompt Boolean             @default(false)
  
  // Utilize JSONB for extensible, category-specific metadata.
  metadata        Json?                 @default("{}")
  preferences     Json?                 @default("{}")
  verificationData Json?                @default("{}")
  rating          Int                   @default(0)
}

model OTP {
  id        String   @id @default(cuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String        @db.Text
  targetAudience String
  industry       String[]
  requirements   String        @db.Text
  specificNotes  String?       @db.Text
  budgetRange    BudgetTier
  timeline       TimelineTier
  coverImageUrl  String?
  category       String        @default("Technology & Software")
  categoryData   Json?         @default("{}")
  status         ProjectStatus @default(PENDING)
  clientId       String
  client         User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assignments    ProjectAssignment[]
  resources      ProjectResource[]
  updates        ProjectUpdate[]
  meetings       ProjectMeeting[]
  documents      ProjectDocument[]
  projectInfo    ProjectInfo[]
  tasks          ProjectTask[]
  sprints        ProjectSprint[]

  // ── NEW: Client Dashboard fields ──
  totalBudget       Float      @default(0)       // Total project budget in actual amount
  budgetUsed        Float      @default(0)       // How much has been spent
  versionLabel      String?                      // e.g., "MVP (v0.1)"
  projectManagerId  String?
  projectManager    User?      @relation("managedProjects", fields: [projectManagerId], references: [id], onDelete: SetNull)
  timelineStart     DateTime?                    // Actual project start date
  timelineEnd       DateTime?                    // Actual project end date

  // Project Messaging
  conversation      Conversation?
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?
  note      String?  @db.Text
  status    String   @default("ACTIVE")
  assignedAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectResource {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  url         String
  type        String   @default("LINK") // LINK, FILE
  platform    String?  // GITHUB, FIGMA, JIRA, TRELLO, OTHER
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  authorId    String
  isUrgent    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMeeting {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  meetingLink String
  startTime   DateTime
  endTime     DateTime?
  duration    String?  // e.g., "45 mins"
  attendeeIds String[] // Array of user IDs targeted for this meeting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectDocument {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  url         String
  type        String   @default("DOC") // SRS, SPRINT, DELIVERABLE, DOC
  description String?  @db.Text
  professionalIds String[] // Targeted professional IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectInfo {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  professionalIds String[] // Targeted professional IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      String   @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, DONE, DO_AGAIN, CANCELLED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  professionalIds String[] // Targeted/Assigned professional IDs
  
  // Reporting fields (Professional)
  reportContent String?   @db.Text
  reportMedia   String[]  // Links to images/videos
  reportLinks   String[]  // External links
  reportedAt    DateTime?
  
  // Review fields (Admin)
  adminFeedback String?   @db.Text
  reviewedAt    DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  sprintId    String?
  sprint      ProjectSprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  progress    Float          @default(0)
  sprintWeight  Float        @default(0) // weight of task in the sprint (0-100)
  
  duration      String?
  richText      String?      @db.Text
}

// ────────── UPDATED: ProjectSprint ──────────

model ProjectSprint {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?       @db.Text
  deliverables    String?       @db.Text   // Legacy text-based deliverables
  startDate       DateTime?
  dueDate         DateTime?
  projectWeight   Float         @default(0) // weight of sprint in the project (0-100)
  progress        Float         @default(0) // completion progress (0-100)
  assets          String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tasks           ProjectTask[]
  duration        String?
  richText        String?       @db.Text

  // ── NEW: Client Dashboard fields ──
  sprintNumber    Int           @default(0)        // Sprint 1, Sprint 2, etc.
  order           Int           @default(0)        // Display order
  status          SprintStatus  @default(PLANNED)  // Replaces old string status
  budget          Float         @default(0)        // Budget allocated to this sprint

  // New relations
  objectives      SprintObjective[]
  sprintDeliverables SprintDeliverable[]
  payment         SprintPayment?
  reviews         SprintReview[]
  comments        SprintComment[]
  activities      SprintActivity[]
}

// ────────── NEW MODELS for Client Dashboard ──────────

model SprintObjective {
  id           String        @id @default(cuid())
  sprintId     String
  sprint       ProjectSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  title        String
  description  String?       @db.Text
  isCompleted  Boolean       @default(false)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SprintDeliverable {
  id           String            @id @default(cuid())
  sprintId     String
  sprint       ProjectSprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  title        String
  description  String?           @db.Text
  type         DeliverableType   @default(OTHER)
  fileUrl      String?
  fileName     String?
  fileSize     String?           // e.g., "2.4 MB"
  commitCount  Int?              // For GitHub repositories
  status       DeliverableStatus @default(PENDING)
  authorId     String?           // User who uploaded/submitted this deliverable
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model SprintPayment {
  id              String        @id @default(cuid())
  sprintId        String        @unique
  sprint          ProjectSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  totalAmount     Float
  amountPaid      Float         @default(0)
  status          PaymentStatus @default(UNPAID)
  transactionRef  String?
  receiptUrl      String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SprintReview {
  id           String        @id @default(cuid())
  sprintId     String
  sprint       ProjectSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  reviewerId   String        // The user (client) who reviewed
  action       ReviewAction  // APPROVED or CHANGES_REQUESTED
  comment      String?       @db.Text
  createdAt    DateTime      @default(now())
}

model SprintComment {
  id           String        @id @default(cuid())
  sprintId     String
  sprint       ProjectSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  authorId     String        // User who posted
  content      String        @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SprintActivity {
  id           String        @id @default(cuid())
  sprintId     String
  sprint       ProjectSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  type         String        // SPRINT_STARTED, DELIVERABLE_SUBMITTED, SPRINT_READY_FOR_REVIEW, SPRINT_APPROVED, CHANGE_REQUESTED, COMMENT_ADDED, OBJECTIVE_COMPLETED, SPRINT_COMPLETED
  description  String
  actorId      String?       // User who performed the action (null for system events)
  createdAt    DateTime      @default(now())
}

// ────────────────── EXISTING MODELS (unchanged) ──────────────────

model InvestmentPitch {
  id                String      @id @default(cuid())
  problemStatement  String      @db.Text
  proposedSolution  String      @db.Text
  usp               String      @db.Text
  marketSize        String
  traction          String?     @db.Text
  competitors       String?     @db.Text
  fundingAmount     String
  equityOffered     String
  useOfFunds        String      @db.Text
  pitchDeckUrl      String
  businessPlanUrl   String?
  status            PitchStatus @default(PENDING)
  clientId          String
  client            User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // TASK, RESOURCE, MEETING, BRIEFING, DOC, INFO
  link      String?  // Deep link to the project/tab
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ────────────────── MESSAGING MODELS ──────────────────

enum MessageType {
  TEXT
  IMAGE
  FILE
  VIDEO
  AUDIO
  SYSTEM
}

model Conversation {
  id            String    @id @default(cuid())
  name          String?   // Optional name for group chats
  isGroup       Boolean   @default(false)
  
  // Associated Project (optional)
  projectId     String?   @unique
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  participants  ConversationParticipant[]
  messages      Message[]
  
  lastMessageId String?
  lastMessageAt DateTime  @default(now())
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  meetings      Meeting[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lastSeenAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content        String       @db.Text
  type           MessageType  @default(TEXT)
  
  // Attachments metadata
  fileUrl        String?
  fileName       String?
  fileSize       String?
  
  // WhatsApp-style reply logic
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: NoAction)
  replies        Message[]    @relation("MessageReplies")

  isRead         Boolean      @default(false)
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Meeting {
  id              String       @id @default(cuid())
  title           String       @default("Interactive Session")
  description     String?      @db.Text
  startTime       DateTime
  endTime         DateTime?
  meetingLink     String       @default("https://meet.google.com")
  status          String       @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  creatorId       String
  creator         User         @relation("MeetingCreator", fields: [creatorId], references: [id])
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
