// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Enforce data integrity with strict Enumerations.
enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalCategory {
  SOFTWARE_DEVELOPER
  PROJECT_MANAGER
  PRODUCT_DESIGNER
  GRAPHIC_DESIGNER
  CONTENT_CREATOR
  DIGITAL_MARKETER
  ACCOUNTANT
  VIDEO_EDITOR
  SOCIAL_MEDIA_MANAGER
  LAWYER
  HR_SPECIALIST
  DATA_ANALYST
}

enum VettingStatus {
  PENDING
  VETTED
  REJECTED
}

enum ProjectStatus {
  PENDING
  REVIEWING
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum PitchStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum BudgetTier {
  UNDER_5K
  FROM_5K_TO_10K
  FROM_10K_TO_25K
  FROM_25K_TO_50K
  ABOVE_50K
}

enum TimelineTier {
  UNDER_1_MONTH
  FROM_1_TO_3_MONTHS
  FROM_3_TO_6_MONTHS
  ABOVE_6_MONTHS
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?
  password      String?
  role          Role      @default(CLIENT)
  provider      String    @default("credentials")
  providerId    String?
  phone         String?
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  otps          OTP[]
  profile       Profile?
  projects      Project[]
  pitches       InvestmentPitch[]
  assignments   ProjectAssignment[]
  notifications Notification[]
}

model Profile {
  id              String                @id @default(cuid())
  userId          String                @unique
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  bio             String?
  avatarUrl       String?
  
  // Professional specific fields
  category        ProfessionalCategory?
  vettingStatus   VettingStatus         @default(PENDING)
  onboardingComplete Boolean            @default(false)
  hasSeenRolePrompt Boolean             @default(false)
  
  // Utilize JSONB for extensible, category-specific metadata.
  metadata        Json?                 @default("{}")
  verificationData Json?                @default("{}")
}

model OTP {
  id        String   @id @default(cuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String        @db.Text
  targetAudience String
  industry       String[]
  requirements   String        @db.Text
  specificNotes  String?       @db.Text
  budgetRange    BudgetTier
  timeline       TimelineTier
  status         ProjectStatus @default(PENDING)
  clientId       String
  client         User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assignments    ProjectAssignment[]
  resources      ProjectResource[]
  updates        ProjectUpdate[]
  meetings       ProjectMeeting[]
  documents      ProjectDocument[]
  projectInfo    ProjectInfo[]
  tasks          ProjectTask[]
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?
  note      String?  @db.Text
  status    String   @default("ACTIVE")
  assignedAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectResource {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  url         String
  type        String   @default("LINK") // LINK, FILE
  platform    String?  // GITHUB, FIGMA, JIRA, TRELLO, OTHER
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  authorId    String
  isUrgent    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMeeting {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  meetingLink String
  startTime   DateTime
  endTime     DateTime?
  duration    String?  // e.g., "45 mins"
  attendeeIds String[] // Array of user IDs targeted for this meeting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectDocument {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  url         String
  type        String   @default("DOC") // SRS, SPRINT, DELIVERABLE, DOC
  description String?  @db.Text
  professionalIds String[] // Targeted professional IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectInfo {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  professionalIds String[] // Targeted professional IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      String   @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  professionalIds String[] // Targeted/Assigned professional IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InvestmentPitch {
  id                String      @id @default(cuid())
  problemStatement  String      @db.Text
  proposedSolution  String      @db.Text
  usp               String      @db.Text
  marketSize        String
  traction          String?     @db.Text
  competitors       String?     @db.Text
  fundingAmount     String
  equityOffered     String
  useOfFunds        String      @db.Text
  pitchDeckUrl      String
  businessPlanUrl   String?
  status            PitchStatus @default(PENDING)
  clientId          String
  client            User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // TASK, RESOURCE, MEETING, BRIEFING, DOC, INFO
  link      String?  // Deep link to the project/tab
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
