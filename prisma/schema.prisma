// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Enforce data integrity with strict Enumerations.
enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalCategory {
  SOFTWARE_DEVELOPER
  PROJECT_MANAGER
  PRODUCT_DESIGNER
  GRAPHIC_DESIGNER
  CONTENT_CREATOR
  DIGITAL_MARKETER
  ACCOUNTANT
  VIDEO_EDITOR
  SOCIAL_MEDIA_MANAGER
  LAWYER
  HR_SPECIALIST
  DATA_ANALYST
}

enum VettingStatus {
  PENDING
  VETTED
  REJECTED
}

enum ProjectStatus {
  PENDING
  REVIEWING
  ACTIVE
  COMPLETED
}

enum PitchStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum BudgetTier {
  UNDER_5K
  FROM_5K_TO_10K
  FROM_10K_TO_25K
  FROM_25K_TO_50K
  ABOVE_50K
}

enum TimelineTier {
  UNDER_1_MONTH
  FROM_1_TO_3_MONTHS
  FROM_3_TO_6_MONTHS
  ABOVE_6_MONTHS
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?
  password      String?
  role          Role      @default(CLIENT)
  provider      String    @default("credentials")
  providerId    String?
  phone         String?
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  otps          OTP[]
  profile       Profile?
  projects      Project[]
  pitches       InvestmentPitch[]
}

model Profile {
  id              String                @id @default(cuid())
  userId          String                @unique
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  bio             String?
  avatarUrl       String?
  
  // Professional specific fields
  category        ProfessionalCategory?
  vettingStatus   VettingStatus         @default(PENDING)
  onboardingComplete Boolean            @default(false)
  hasSeenRolePrompt Boolean             @default(false)
  
  // Utilize JSONB for extensible, category-specific metadata.
  metadata        Json?                 @default("{}")
  verificationData Json?                @default("{}")
}

model OTP {
  id        String   @id @default(cuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String        @db.Text
  targetAudience String
  industry       String[]
  requirements   String        @db.Text
  specificNotes  String?       @db.Text
  budgetRange    BudgetTier
  timeline       TimelineTier
  status         ProjectStatus @default(PENDING)
  clientId       String
  client         User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model InvestmentPitch {
  id                String      @id @default(cuid())
  problemStatement  String      @db.Text
  proposedSolution  String      @db.Text
  usp               String      @db.Text
  marketSize        String
  traction          String?     @db.Text
  competitors       String?     @db.Text
  fundingAmount     String
  equityOffered     String
  useOfFunds        String      @db.Text
  pitchDeckUrl      String
  businessPlanUrl   String?
  status            PitchStatus @default(PENDING)
  clientId          String
  client            User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}